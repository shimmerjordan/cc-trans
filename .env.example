# cc-trans docker compose 可选配置
#
#   cp .env.example .env     # 改一次永久生效,两份 compose 都会读取
#
# 不需要改任何东西时,这个文件可以完全不建。

# ── 通用(docker-compose.yml 与 docker-compose.build.yml 都生效)────────────
# 宿主机端口(容器内固定 8787)。已有服务占用 8787 时改这里。
#CC_TRANS_HOST_PORT=8787

# 容器内进程的运行身份。留空时自动取挂载进来的 ~/.claude 属主,取不到则用 1000 ——
# 单用户 Linux 基本不用管。只有宿主机 uid 不是 1000 且没挂 ~/.claude 时才需要显式指定
# (设错会导致 data/ 里的文件在宿主机上不可读写)。查自己的:id -u / id -g
#PUID=1000
#PGID=1000

# ── 仅 docker-compose.build.yml(源码构建)生效 ────────────────────────────
# 基础镜像。默认已是 docker.m.daocloud.io 镜像源(直连 Docker Hub 在国内常超时)。
# 海外机器 / 网络通,或想用官方源时改成:
#NODE_IMAGE=node:22-alpine

# 需要上游 HTTP/SOCKS5 代理(config.upstreamProxy)时设为 1,构建时会装 undici。
# 不用代理保持 0,镜像即为零第三方依赖。
#WITH_UNDICI=0
